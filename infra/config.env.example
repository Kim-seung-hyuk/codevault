# infra/config.env 로 복사해서 값을 채운다 (config.env 는 .gitignore 대상 — 비밀값 포함)
REGION=us-east-1
# 전역에서 유일해야 함
BUCKET=codevault-demo-change-me
LAMBDA_NAME=codevault-watermark
# 비워 두면 02-iam.sh 가 만든 codevault-lambda-role 을 쓴다.
# 실습 계정에 이미 있는 역할(예: AWS Academy 의 LabRole)이 있으면 그 ARN 을 넣는다.
LAMBDA_ROLE_ARN=
# EC2 퍼블릭 주소 (탄력적 IP 권장). Lambda 콜백 주소와 S3 CORS 허용 Origin 에 쓰인다.
EC2_PUBLIC_URL=http://203.0.113.10
# 공유 비밀값: openssl rand -hex 24 로 만든다. EC2 의 /etc/codevault.env 와 같아야 한다.
CALLBACK_SECRET=
WM_SECRET=
# outputs/ 보관 기간(일)
OUTPUT_EXPIRE_DAYS=7
